rules_version = '2';

// ============================================================================
// LIMITE DA PLATAFORMA — leia antes de mexer
//
// Uma avaliação de regra do Cloud Storage pode ler NO MÁXIMO DOIS documentos do
// Firestore. Passando disso a avaliação falha e o upload é negado, mesmo com o
// usuário tendo permissão de verdade.
// https://firebase.google.com/docs/storage/security/rules-conditions
//
// Era exatamente o que quebrava eventos, avisos, comprovantes, financeiro,
// fornecedores, patrimônio e foto de membro neste app: a cadeia antiga
// (isChurchStaffWriter / isChurchMember) chegava a consultar sete caminhos —
// users/{uid}, igrejas/{id}, igrejas/{id}/users/{uid}, .../membros/{uid},
// .../membros/{cpf}, .../membros/__none__. Como as checagens são `||`, quem
// tivesse role de admin em users/{uid} passava lendo um documento só e
// funcionava; gestor, tesoureiro e membro comum seguiam para o terceiro e
// quarto documento e levavam permission-denied.
//
// REGRA DE OURO — cada avaliação lê no máximo:
//   DOC A  users/{uid}                papel global e igreja do usuário
//   DOC B  igrejas/{t}/users/{uid}    papel/permissões na igreja   (trilha STAFF)
//   DOC C  igrejas/{t}/membros/{uid}  vínculo de membro            (trilha MEMBRO)
//
// staffWriter()   usa A + B      churchMember()  usa A + C
// NUNCA combine as duas trilhas no mesmo allow — soma três documentos e volta a
// estourar. Para os casos mistos (fotos de membro) existe staffLite(), que
// decide só com o token e o DOC A, sem custo de documento extra.
//
// Nunca use `match /{allPaths=**} { allow read: if true; }` — isso expõe
// qualquer objeto do bucket a quem descobrir a URL.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // ---------------------------------------------------------------- 0 docs
    function isSignedIn() {
      return request.auth != null;
    }

    function emailLower() {
      return isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower() : '';
    }

    // Operador da plataforma — decidido só pelo token, sem ler Firestore.
    function isMasterEmail() {
      return emailLower() == 'raihom@gmail.com'
        || emailLower() == 'isabellecardoso@gmail.com'
        || emailLower() == 'isabelle.cardoso@gmail.com';
    }

    function tokenRole() {
      return isSignedIn() && request.auth.token.role is string
        ? request.auth.token.role : '';
    }

    // Vínculo com a igreja pelo custom claim (backfillUsersIndex grava role + igrejaId).
    function tokenTenantMatches(t) {
      return isSignedIn() && (
        (request.auth.token.igrejaId is string && request.auth.token.igrejaId == t)
        || (request.auth.token.tenantId is string && request.auth.token.tenantId == t)
        || (request.auth.token.churchId is string && request.auth.token.churchId == t)
        || (request.auth.token.churchCanonicalId is string && request.auth.token.churchCanonicalId == t)
        || (request.auth.token.canonicalTenantId is string && request.auth.token.canonicalTenantId == t)
      );
    }

    // ------------------------------------------------------- DOC A: users/{uid}
    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }
    function userData() {
      return firestore.get(userPath()).data;
    }
    function userExists() {
      return isSignedIn() && firestore.exists(userPath());
    }
    function userRole() {
      return userExists() && userData().get('role', '') is string
        ? userData().get('role', '') : '';
    }
    function userTenantMatches(t) {
      return userExists() && (
        userData().get('igrejaId', '') == t
        || userData().get('tenantId', '') == t
        || userData().get('churchId', '') == t
      );
    }

    // ------------------------------------ DOC B: igrejas/{t}/users/{uid} (STAFF)
    function tenantUserPath(t) {
      return /databases/(default)/documents/igrejas/$(t)/users/$(request.auth.uid);
    }
    function tenantUserData(t) {
      return firestore.get(tenantUserPath(t)).data;
    }
    function tenantUserExists(t) {
      return isSignedIn() && firestore.exists(tenantUserPath(t));
    }
    function tenantUserRole(t) {
      return tenantUserExists(t) && tenantUserData(t).get('role', '') is string
        ? tenantUserData(t).get('role', '') : '';
    }
    function tenantUserPerms(t) {
      return tenantUserExists(t) && tenantUserData(t).permissions is list
        ? tenantUserData(t).permissions
        : (tenantUserExists(t) && tenantUserData(t).roles is list
          ? tenantUserData(t).roles : []);
    }

    // ---------------------------------- DOC C: igrejas/{t}/membros/{uid} (MEMBRO)
    function membroPath(t) {
      return /databases/(default)/documents/igrejas/$(t)/membros/$(request.auth.uid);
    }
    function membroExists(t) {
      return isSignedIn() && firestore.exists(membroPath(t));
    }
    // ------------------------------------------------------------- Papéis
    // Staff: gestor, admin, pastor, secretário, tesoureiro, presbítero, líder.
    // Comparação em minúsculas — a lista antiga repetia cada cargo em 4 grafias.
    function isStaffRole(r) {
      return r is string && (
        r.lower() == 'gestor' || r.lower() == 'admin' || r.lower() == 'adm'
        || r.lower() == 'administrador' || r.lower() == 'administradora'
        || r.lower() == 'master'
        || r.lower() == 'pastor' || r.lower() == 'pastora'
        || r.lower() == 'pastor_presidente' || r.lower() == 'pastor presidente'
        || r.lower() == 'pastor_auxiliar' || r.lower() == 'pastor auxiliar'
        || r.lower() == 'ministerial' || r.lower() == 'pastor_auxiliar_ministerial'
        || r.lower() == 'secretario' || r.lower() == 'secretário'
        || r.lower() == 'secretaria' || r.lower() == 'secretária'
        || r.lower() == 'tesoureiro' || r.lower() == 'tesouraria'
        || r.lower() == 'presbitero' || r.lower() == 'presbítero'
        || r.lower() == 'presbitera' || r.lower() == 'presbítera'
        || r.lower() == 'lider' || r.lower() == 'líder'
        || r.lower() == 'lider_departamento' || r.lower() == 'lider departamento'
        || r.lower() == 'lider_depto' || r.lower() == 'lider_grupo'
        || r.lower() == 'lider grupo' || r.lower() == 'lider_de_grupo'
      );
    }

    function hasFinancePerm(perms) {
      return perms is list && perms.hasAny([
        'financeiro', 'fornecedores', 'eventos', 'eventos_avisos_edicao', 'mural_avisos_edicao'
      ]);
    }
    function hasPatrimonioPerm(perms) {
      return perms is list && perms.hasAny(['patrimonio']);
    }
    function hasMuralPerm(perms) {
      return perms is list && perms.hasAny([
        'eventos', 'eventos_avisos_edicao', 'mural_avisos_edicao'
      ]);
    }

    // ------------------------------------------------------ Autorização (topo)

    // staffLite — token + DOC A. Custo: no máximo 1 documento.
    // Existe para os casos que precisam combinar staff e membro no mesmo allow.
    function staffLite() {
      return isSignedIn() && (
        isMasterEmail()
        || isStaffRole(tokenRole())
        || isStaffRole(userRole())
      );
    }

    // staffWriter — trilha STAFF. Custo: DOC A + DOC B = 2 documentos.
    function staffWriter(t) {
      return isSignedIn() && (
        isMasterEmail()
        || isStaffRole(tokenRole())
        || isStaffRole(userRole())
        || isStaffRole(tenantUserRole(t))
        || hasFinancePerm(tenantUserPerms(t))
      );
    }

    // patrimonioWriter — staff ou permissão granular. Custo: DOC A + DOC B.
    function patrimonioWriter(t) {
      return isSignedIn() && (
        isMasterEmail()
        || isStaffRole(tokenRole())
        || isStaffRole(userRole())
        || isStaffRole(tenantUserRole(t))
        || hasPatrimonioPerm(tenantUserPerms(t))
      );
    }

    // muralWriter — staff ou permissão de mural. Custo: DOC A + DOC B.
    function muralWriter(t) {
      return isSignedIn() && (
        isMasterEmail()
        || isStaffRole(tokenRole())
        || isStaffRole(userRole())
        || isStaffRole(tenantUserRole(t))
        || hasMuralPerm(tenantUserPerms(t))
      );
    }

    // churchMember — trilha MEMBRO. Custo: DOC A + DOC C = 2 documentos.
    function churchMember(t) {
      return isSignedIn() && (
        isMasterEmail()
        || isStaffRole(tokenRole())
        || tokenTenantMatches(t)
        || userTenantMatches(t)
        || isStaffRole(userRole())
        || membroExists(t)
      );
    }

    // ------------------------------------------------------------ Tipos de arquivo
    // iOS e Android mandam MIME atípico (heic, quicktime) e o picker às vezes não
    // manda nenhum — daí octet-stream e '' serem aceitos em todos os grupos.
    function photoImageOrBlob() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'image/heic'
        || request.resource.contentType == 'image/heif'
        || request.resource.contentType == 'application/octet-stream'
        || request.resource.contentType == '';
    }

    function mediaImageVideoOrBlob() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('video/.*')
        || request.resource.contentType == 'application/octet-stream'
        || request.resource.contentType == '';
    }

    // Comprovantes: imagem ou PDF + blob.
    function comprovanteOrBlob() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('application/pdf')
        || request.resource.contentType == 'application/octet-stream'
        || request.resource.contentType == '';
    }

    function pkcs12OrBlob() {
      return request.resource.contentType == 'application/x-pkcs12'
        || request.resource.contentType == 'application/pkcs12'
        || request.resource.contentType == 'application/octet-stream';
    }

    function publicMediaPdfOrBlob() {
      return request.resource.contentType.matches('video/.*')
        || request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('application/pdf')
        || request.resource.contentType == 'application/octet-stream'
        || request.resource.contentType == '';
    }

    function underMax(maxBytes) {
      return request.resource != null && request.resource.size < maxBytes;
    }

    // Cadastro público (web): `membros/fotos/{id}.webp` ou legado `foto_perfil.jpg`
    function isMemberCanonicalProfilePhotoPath(p) {
      return p.matches('^fotos/[^/]+\\.webp$')
        || p.matches('^thumbs/[^/]+\\.webp$')
        || p.matches('^[^/]+/foto_perfil\\.jpg$');
    }

    // ========================================================== CAMINHOS

    // Upload público de foto de membro (cadastro sem login) — sem vídeo.
    match /members/{tenantId}/{fileName} {
      allow write: if request.auth == null
        && underMax(15 * 1024 * 1024)
        && photoImageOrBlob();
      allow read: if true;
    }

    // Cadastro público: foto temporária, isolada pelo UID anónimo da sessão.
    // A aprovação server-side move o objeto para `membros/{id}`.
    // Custo: 0 documentos — só compara UID do caminho.
    match /igrejas/{igrejaId}/pending_member_signups/{ownerUid}/{signupId}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == ownerUid;
      allow create, update: if isSignedIn()
        && request.auth.uid == ownerUid
        && underMax(15 * 1024 * 1024)
        && photoImageOrBlob();
      allow delete: if isSignedIn() && request.auth.uid == ownerUid;
    }

    // Fotos de membros. Caso misto (membro edita a própria foto, secretaria edita
    // a de outro): churchMember (A+C) + staffLite (sem documento novo) = 2 docs.
    match /igrejas/{igrejaId}/membros/{path=**} {
      allow read: if true;
      allow create, update: if underMax(20 * 1024 * 1024)
        && photoImageOrBlob()
        && churchMember(igrejaId)
        && (
          isMemberCanonicalProfilePhotoPath(path)
          || staffLite()
          || path.matches('^fotos/.*')
          || path.matches('^thumbs/.*')
        );
      // Delete não tem request.resource — sem checagem de size/contentType.
      allow delete: if staffLite() || (churchMember(igrejaId) && (
        path.matches('^fotos/.*')
        || path.matches('^thumbs/.*')
        || path.matches('^[^/]+/foto_perfil\\.jpg$')
      ));
    }

    // Certificado digital A1 (PKCS#12) — só staff.
    match /igrejas/{igrejaId}/certificados_gestor/{fileName} {
      allow read: if staffWriter(igrejaId);
      allow write: if staffWriter(igrejaId)
        && underMax(10 * 1024 * 1024)
        && pkcs12OrBlob();
    }

    // Logo na raiz da igreja — só staff.
    match /igrejas/{igrejaId}/{fileName} {
      allow read: if true;
      allow create, update: if staffWriter(igrejaId)
        && underMax(25 * 1024 * 1024)
        && photoImageOrBlob();
      // Delete nao tem request.resource — sem checagem de size/contentType.
      allow delete: if staffWriter(igrejaId);
    }

    // Identidade: logo, assinatura — só staff.
    match /igrejas/{igrejaId}/configuracoes/{fileName} {
      allow read: if true;
      allow create, update: if staffWriter(igrejaId)
        && underMax(15 * 1024 * 1024)
        && photoImageOrBlob();
      // Delete nao tem request.resource — sem checagem de size/contentType.
      allow delete: if staffWriter(igrejaId);
    }

    // Foto do gestor — só staff.
    match /igrejas/{igrejaId}/gestor/{path=**} {
      allow read: if true;
      allow create, update: if staffWriter(igrejaId)
        && underMax(20 * 1024 * 1024)
        && photoImageOrBlob();
      // Delete nao tem request.resource — sem checagem de size/contentType.
      allow delete: if staffWriter(igrejaId);
    }

    match /noticias/{tenantId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /departamentos/{tenantId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /patrimonio/{tenantId}/{path=**} {
      allow read: if true;
      allow write: if false;
    }

    // Comprovantes (legado, na raiz da igreja).
    match /igrejas/{igrejaId}/comprovantes/{fileName} {
      allow read: if churchMember(igrejaId);
      allow create, update: if staffWriter(igrejaId)
        && underMax(15 * 1024 * 1024)
        && comprovanteOrBlob();
      allow delete: if staffWriter(igrejaId);
    }

    // Financeiro — comprovantes (igrejas/{id}/financeiro/AAAA_MM/...).
    // DELETE: request.resource é null — não exigir size/MIME (bug clássico).
    match /igrejas/{igrejaId}/financeiro/{path=**} {
      allow read: if churchMember(igrejaId);
      allow create, update: if staffWriter(igrejaId)
        && underMax(15 * 1024 * 1024)
        && comprovanteOrBlob();
      allow delete: if staffWriter(igrejaId);
    }

    // Mural eventos/avisos/notícias — membro da igreja (quem cria é controlado no app).
    match /igrejas/{igrejaId}/eventos/{path=**} {
      allow read: if true;
      allow create, update: if churchMember(igrejaId)
        && underMax(120 * 1024 * 1024)
        && mediaImageVideoOrBlob();
      // Delete nao tem request.resource — sem checagem de size/contentType.
      allow delete: if churchMember(igrejaId);
    }

    match /igrejas/{igrejaId}/noticias/{path=**} {
      allow read: if true;
      allow create, update: if churchMember(igrejaId)
        && underMax(120 * 1024 * 1024)
        && mediaImageVideoOrBlob();
      // Delete nao tem request.resource — sem checagem de size/contentType.
      allow delete: if churchMember(igrejaId);
    }

    match /igrejas/{igrejaId}/avisos/{path=**} {
      allow read: if true;
      allow create, update: if churchMember(igrejaId)
        && underMax(120 * 1024 * 1024)
        && mediaImageVideoOrBlob();
      // Delete nao tem request.resource — sem checagem de size/contentType.
      allow delete: if churchMember(igrejaId);
    }

    // Fotos de departamentos — staff ou permissão de mural.
    match /igrejas/{igrejaId}/departamentos/{path=**} {
      allow read: if true;
      allow create, update: if muralWriter(igrejaId)
        && underMax(15 * 1024 * 1024)
        && photoImageOrBlob();
      // Delete nao tem request.resource — sem checagem de size/contentType.
      allow delete: if muralWriter(igrejaId);
    }

    match /tenants/{tenantId}/media/{path=**} {
      allow read: if true;
      allow write: if false;
    }

    // Chat REMOVIDO — chat_media / chat_stickers caem no deny-by-default.

    match /eventos/{eventoId}/{path=**} {
      allow read: if true;
      allow write: if false;
    }

    match /certificado_logos/{tenantId}/{fileName} {
      allow read: if true;
      allow create, update: if staffWriter(tenantId)
        && underMax(10 * 1024 * 1024)
        && photoImageOrBlob();
      // Delete nao tem request.resource — sem checagem de size/contentType.
      allow delete: if staffWriter(tenantId);
    }

    match /carteira_logos/{tenantId}/{fileName} {
      allow read: if true;
      allow create, update: if staffWriter(tenantId)
        && underMax(10 * 1024 * 1024)
        && photoImageOrBlob();
      // Delete nao tem request.resource — sem checagem de size/contentType.
      allow delete: if staffWriter(tenantId);
    }

    // Cartão de membro — logo dedicada (padrão: igrejas/{id}/cartao_membro/).
    match /igrejas/{igrejaId}/cartao_membro/{path=**} {
      allow read: if true;
      allow create, update: if staffWriter(igrejaId)
        && underMax(10 * 1024 * 1024)
        && photoImageOrBlob();
      // Delete nao tem request.resource — sem checagem de size/contentType.
      allow delete: if staffWriter(igrejaId);
    }

    match /igrejas/{igrejaId}/certificados/{path=**} {
      allow read: if true;
      allow create, update: if staffWriter(igrejaId)
        && underMax(25 * 1024 * 1024)
        && photoImageOrBlob();
      // Delete nao tem request.resource — sem checagem de size/contentType.
      allow delete: if staffWriter(igrejaId);
    }

    // Patrimônio — fotos dos bens. Staff ou permissão granular 'patrimonio'.
    match /igrejas/{igrejaId}/patrimonio/{path=**} {
      allow read: if true;
      allow create, update: if patrimonioWriter(igrejaId)
        && underMax(20 * 1024 * 1024)
        && photoImageOrBlob();
      // Delete: request.resource é null — sem checagem de size/contentType.
      allow delete: if patrimonioWriter(igrejaId);
    }

    // Capa marketing (Master / site divulgação) — staff da igreja.
    match /igrejas/{igrejaId}/marketing_destaque/{path=**} {
      allow read: if true;
      allow create, update: if staffWriter(igrejaId)
        && underMax(15 * 1024 * 1024)
        && photoImageOrBlob();
      // Delete nao tem request.resource — sem checagem de size/contentType.
      allow delete: if staffWriter(igrejaId);
    }

    // Templates certificados — fundos HD.
    match /igrejas/{igrejaId}/templates/certificados/{path=**} {
      allow read: if true;
      allow create, update: if staffWriter(igrejaId)
        && underMax(25 * 1024 * 1024)
        && photoImageOrBlob();
      // Delete nao tem request.resource — sem checagem de size/contentType.
      allow delete: if staffWriter(igrejaId);
    }

    // Fornecedores — comprovantes de compromissos (foto/PDF).
    match /igrejas/{igrejaId}/fornecedores/{path=**} {
      allow read: if true;
      allow create, update: if staffWriter(igrejaId)
        && underMax(15 * 1024 * 1024)
        && (photoImageOrBlob() || comprovanteOrBlob());
      allow delete: if staffWriter(igrejaId);
    }

    // Uploads genéricos — membro da igreja.
    match /igrejas/{igrejaId}/uploads/{path=**} {
      allow read: if churchMember(igrejaId);
      allow write: if churchMember(igrejaId)
        && underMax(300 * 1024 * 1024)
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType.matches('text/.*')
          || request.resource.contentType.matches('application/.*')
          || request.resource.contentType == ''
        );
    }

    // Divulgação Gestão YAHWEH (`public/gestao_yahweh/...`). Em DELETE
    // `request.resource` é nulo — por isso a checagem de tamanho fica só no create.
    match /public/{path=**} {
      allow read: if true;
      allow delete: if isSignedIn();
      allow create, update: if isSignedIn()
        && underMax(200 * 1024 * 1024)
        && publicMediaPdfOrBlob();
    }

    // Demais pastas sob igrejas/{id}/... (as tratadas acima ficam de fora).
    match /igrejas/{igrejaId}/{seg}/{rest=**} {
      allow read: if seg != 'certificados_gestor';
      allow write: if staffWriter(igrejaId)
        && seg != 'eventos'
        && seg != 'noticias'
        && seg != 'avisos'
        && seg != 'configuracoes'
        && seg != 'gestor'
        && seg != 'chat_media'
        && seg != 'chat_stickers'
        && seg != 'departamentos'
        && seg != 'uploads'
        && seg != 'patrimonio'
        && seg != 'certificados'
        && seg != 'cartao_membro'
        && seg != 'comprovantes'
        && seg != 'financeiro'
        && seg != 'fornecedores'
        && seg != 'marketing_destaque'
        && seg != 'templates'
        && seg != 'certificados_gestor'
        && seg != 'membros'
        && seg != 'pending_member_signups'
        && underMax(10 * 1024 * 1024)
        && photoImageOrBlob();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
