rules_version = '2';
// ============================================================================
// Gestão YAHWEH — REGRAS ENXUTAS (v4), UID-based.
// Reescrita da versão de 2222 linhas aproveitando a identidade canônica
// (todo membro keyado por uid + authUid; todo user com igrejaId/cpf/email).
// Preserva a MESMA fronteira de segurança por módulo; remove o cruft legado
// (match por CPF de 5 campos, tolerância de tenant `id_`/`v_`/regex, listas
// gigantes de variação de cargo -> normalizadas com .lower()).
// Cargos aceitos são os mesmos, comparados em minúsculo (case-insensitive).
// REVISÃO: validar no emulador + testes antes de publicar. NÃO é over-permit:
// deny-by-default no fim; na dúvida, mais restrito (recuperável), nunca aberto.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Base ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function emailLower() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower() : '';
    }
    function userDoc() { return /databases/$(database)/documents/users/$(uid()); }

    // ---------- Operador global de plataforma (master) ----------
    function masterByCpf() {
      let p = userDoc();
      return exists(p) && (
        get(p).data.get('cpf', '') == '94536368191'
        || get(p).data.get('CPF', '') == '94536368191'
        || get(p).data.get('linkedCpf', '') == '94536368191'
      );
    }
    function isMaster() {
      return signedIn() && (
        emailLower() == 'raihom@gmail.com'
        || emailLower() == 'isabellecardoso@gmail.com'
        || emailLower() == 'isabelle.cardoso@gmail.com'
        || masterByCpf()
        || exists(/databases/$(database)/documents/admins/$(uid()))
      );
    }
    function isAdminPanel() { return isMaster(); }

    // ---------- Papéis (normalizados) ----------
    // Papel singular: users/{uid}.role || claim role. (roles[] tratado à parte.)
    function roleLowerFrom(p) {
      return exists(p) && get(p).data.role is string ? get(p).data.role.lower() : '';
    }
    function rlow() {
      let fromUser = roleLowerFrom(userDoc());
      return fromUser != '' ? fromUser
        : (signedIn() && request.auth.token.role is string ? request.auth.token.role.lower() : '');
    }
    function tenantUserDoc(t) {
      return /databases/$(database)/documents/igrejas/$(t)/users/$(uid());
    }
    // Papel no doc do tenant (igrejas/{t}/users/{uid}.role) — normalizado.
    function tRole(t) { return roleLowerFrom(tenantUserDoc(t)); }

    // Conjuntos de cargos (minúsculos; acentos incluídos explicitamente).
    function isManagerRole(r) {
      return r == 'admin' || r == 'adm' || r == 'gestor' || r == 'master'
        || r == 'administrador' || r == 'administradora';
    }
    function isPastoralRole(r) {
      return r == 'pastor' || r == 'pastora' || r == 'pastor_presidente'
        || r == 'pastor presidente' || r == 'pastora_presidente' || r == 'pastora presidente'
        || r == 'secretario' || r == 'secretário' || r == 'secretaria' || r == 'secretária'
        || r == 'presbitero' || r == 'presbítero' || r == 'presbitera' || r == 'presbítera';
    }
    function isPastorAuxRole(r) {
      return r == 'pastor_auxiliar' || r == 'pastor auxiliar'
        || r == 'ministerial' || r == 'pastor_auxiliar_ministerial';
    }
    function isTreasurerRole(r) { return r == 'tesoureiro' || r == 'tesouraria'; }
    function isLeaderRole(r) {
      return r == 'lider' || r == 'líder'
        || r == 'lider_departamento' || r == 'lider departamento' || r == 'líder de departamento'
        || r == 'lider_depto' || r == 'lider_de_departamento' || r == 'lider_ministerio'
        || r == 'lider_grupo' || r == 'lider grupo' || r == 'líder de grupo'
        || r == 'lider de grupo' || r == 'lider_de_grupo';
    }
    // Diácono/evangelista/músico — só listam diretório de membros.
    function isDirectoryExtraRole(r) {
      return r == 'diacono' || r == 'diácono' || r == 'evangelista'
        || r == 'musico' || r == 'músico';
    }
    function isMemberOrVisitorRole(r) {
      return r == 'membro' || r == 'visitante';
    }

    // Predicados: papel do usuário (singular no users OU no tenant-user doc).
    function hasRole(t, checkFnResultUser, checkFnResultTenant) {
      return checkFnResultUser || checkFnResultTenant;
    }
    function isManager() { return isManagerRole(rlow()); }
    function isTreasurer(t) { return isTreasurerRole(rlow()) || isTreasurerRole(tRole(t)); }
    function isPastoral(t) { return isPastoralRole(rlow()) || isPastoralRole(tRole(t)); }
    function isPastorAux(t) { return isPastorAuxRole(rlow()) || isPastorAuxRole(tRole(t)); }
    function isLeader(t) { return isLeaderRole(rlow()) || isLeaderRole(tRole(t)); }

    // Permissões granulares (lista `permissions` no users OU tenant-user).
    function hasPerm(t, key) {
      let pu = userDoc();
      let pt = tenantUserDoc(t);
      return (exists(pu) && get(pu).data.permissions is list && get(pu).data.permissions.hasAny([key]))
        || (exists(pt) && get(pt).data.permissions is list && get(pt).data.permissions.hasAny([key]));
    }

    // ---------- Tenant (igreja) ----------
    // igrejaId/tenantId canônico no users/{uid}, no tenant-user doc, ou ficha
    // membros/{uid} (todo membro keyado por uid após o backfill).
    function tenantMatch(t) {
      let p = userDoc();
      return (exists(p) && (
          get(p).data.get('igrejaId', '') == t
          || get(p).data.get('tenantId', '') == t
          || get(p).data.get('churchId', '') == t
          || get(p).data.get('churchCanonicalId', '') == t
        ))
        || request.auth.token.get('igrejaId', '') == t
        || request.auth.token.get('tenantId', '') == t;
    }
    function emailMatchesTenant(t) {
      let ig = /databases/$(database)/documents/igrejas/$(t);
      return signedIn() && request.auth.token.email != null && exists(ig)
        && (get(ig).data.get('email', '') == request.auth.token.email
          || get(ig).data.get('gestorEmail', '') == request.auth.token.email);
    }
    function isTenantMember(t) {
      return exists(/databases/$(database)/documents/igrejas/$(t)/membros/$(uid()));
    }
    function canAccessTenant(t) {
      return signedIn() && (
        isMaster()
        || tenantMatch(t)
        || emailMatchesTenant(t)
        || exists(tenantUserDoc(t))
        || isTenantMember(t)
      );
    }
    // Gestão da igreja (grava cadastro/config): gestor/admin ou e-mail gestor.
    function canWriteTenant(t) {
      return canAccessTenant(t) && (isManager() || emailMatchesTenant(t));
    }

    // ---------- Escrita por módulo ----------
    function canWriteFinance(t) {
      return isAdminPanel() || canWriteTenant(t)
        || (canAccessTenant(t) && (
          isTreasurer(t) || isPastoral(t) || isPastorAux(t)
          || hasPerm(t, 'financeiro') || hasPerm(t, 'fornecedores')
        ));
    }
    function canReadFinance(t) {
      return isMaster() || (canAccessTenant(t) && (
        isManager() || isTreasurer(t) || isPastoral(t)
        || hasPerm(t, 'financeiro')
      ));
    }
    function canWritePatrimonio(t) {
      return isMaster() || canWriteTenant(t) || hasPerm(t, 'patrimonio')
        || (canAccessTenant(t) && (
          isManager() || isPastoral(t) || isPastorAux(t) || isTreasurer(t)
        ));
    }
    function canReadPatrimonio(t) {
      return isMaster() || (canAccessTenant(t) && (
        isManager() || isTreasurer(t) || isPastoral(t) || isPastorAux(t)
        || hasPerm(t, 'patrimonio')
      ));
    }
    // Mural/eventos/avisos/agenda: liderança da igreja (não membro comum).
    function canWriteMural(t) {
      return isAdminPanel() || canWriteTenant(t)
        || (canAccessTenant(t) && (
          isPastoral(t) || isPastorAux(t) || isTreasurer(t) || isLeader(t)
          || hasPerm(t, 'eventos') || hasPerm(t, 'eventos_avisos_edicao')
          || hasPerm(t, 'mural_avisos_edicao')
        ));
    }
    function canWriteDepartamentos(t) {
      return isAdminPanel() || canWriteTenant(t)
        || (canAccessTenant(t) && (
          isPastoral(t) || isTreasurer(t) || isLeader(t) || isPastorAux(t)
          || hasPerm(t, 'departamentos')
        ));
    }
    function canWriteCargos(t) {
      return isAdminPanel() || canWriteTenant(t)
        || (canAccessTenant(t) && (
          isPastoral(t) || isTreasurer(t) || isPastorAux(t) || isLeader(t)
          || hasPerm(t, 'cargos')
        ));
    }
    function canWriteCertificados(t) {
      return canAccessTenant(t) && (
        canWriteTenant(t) || isPastoral(t) || isTreasurer(t) || hasPerm(t, 'certificados')
      );
    }
    // Editar ficha de qualquer membro (equipe).
    function canStaffEditMembers(t) {
      return isMaster() || canWriteTenant(t)
        || (canAccessTenant(t) && (
          isManager() || isPastoral(t) || isPastorAux(t) || isTreasurer(t)
          || hasPerm(t, 'membros') || hasPerm(t, 'membros_edicao')
        ));
    }
    // Listar diretório completo de membros.
    function canReadAllMembers(t) {
      return isMaster() || canStaffEditMembers(t)
        || (canAccessTenant(t) && (
          isLeader(t) || isDirectoryExtraRole(rlow())
          || hasPerm(t, 'membros') || hasPerm(t, 'membros_edicao')
          || (!isMemberOrVisitorRole(rlow()) && hasPerm(t, 'membros_ver'))
        ));
    }
    // Membro é dono desta ficha (keyada por uid, ou authUid == uid).
    function ownsMember(t, memberId) {
      return signedIn() && (
        memberId == uid()
        || (('authUid' in resource.data) && resource.data.authUid == uid())
        || (('firebaseUid' in resource.data) && resource.data.firebaseUid == uid())
      );
    }

    // ---------- Site público ----------
    function publicSiteReadable() {
      return !('publicSite' in resource.data) || resource.data.publicSite == true;
    }

    // ========================================================================
    // Índices/coleções públicas de topo
    // ========================================================================
    match /public_church_slugs/{slugKey} { allow read: if true; allow write: if false; }
    match /publicCpfIndex/{cpfKey} { allow read: if true; allow write: if false; }
    match /config/plans/items/{id} { allow read: if true; allow write: if isMaster(); }
    match /promotions/{promoId} { allow read: if true; allow write: if isMaster(); }
    match /landing_content/{docId} { allow read: if true; allow write: if isMaster(); }
    match /app_config/{docId} { allow read: if true; allow write: if isMaster(); }
    match /config/appVersion { allow read: if true; allow write: if isMaster(); }
    match /config/appDownloads { allow read: if true; allow write: if isMaster(); }
    match /config/marketing_official { allow read: if true; allow write: if isMaster(); }

    // ========================================================================
    // IGREJA (tenant)
    // ========================================================================
    match /igrejas/{id} {
      allow read: if true; // busca/perfil público da igreja
      allow write: if isAdminPanel() || canWriteTenant(id)
        || (canAccessTenant(id) && (
          isManager() || isPastoral(id) || isPastorAux(id) || isTreasurer(id)
        ));

      // ---- Membros ----
      match /membros/{memberId} {
        // self-check barato PRIMEIRO (short-circuit) p/ nao estourar o
        // orcamento de 1000 expressoes com canReadAllMembers na leitura da propria ficha.
        allow read: if ownsMember(id, memberId) || canReadAllMembers(id);
        allow create: if (signedIn() && (
              isMaster() || canStaffEditMembers(id)
              || (canAccessTenant(id) && isLeader(id))
            ))
          // Cadastro público (sem login) — ficha pendente.
          || (request.auth == null
            && request.resource.data.get('PUBLIC_SIGNUP', false) == true
            && request.resource.data.get('STATUS', '') == 'pendente'
            && request.resource.data.get('status', '') == 'pendente'
            && request.resource.data.get('role', '') == 'membro');
        allow update: if (request.auth == null
              && resource.data.get('PUBLIC_SIGNUP', false) == true
              && resource.data.get('STATUS', '') == 'pendente'
              && request.resource.data.get('STATUS', '') == 'pendente')
          || (signedIn() && (
              isMaster() || canStaffEditMembers(id) || ownsMember(id, memberId)
              || (canAccessTenant(id) && isLeader(id))
            ));
        allow delete: if signedIn() && (isMaster() || canWriteTenant(id)
          || (canAccessTenant(id) && isPastoral(id)) || canStaffEditMembers(id));
      }
      match /members/{memberId} {
        allow read: if ownsMember(id, memberId) || canReadAllMembers(id);
        allow create, update: if false;
        allow delete: if signedIn() && (isMaster() || canWriteTenant(id)
          || (canAccessTenant(id) && isPastoral(id)) || canStaffEditMembers(id));
      }

      // ---- Config / credenciais ----
      match /config/{docId} {
        allow read: if docId == 'payment_receiving' || isMaster()
          || (canAccessTenant(id) && (docId != 'mercado_pago' || canManagerConfig(id)));
        allow write: if isAdminPanel() || canWriteTenant(id);
      }
      match /private/{docId} { allow read, write: if false; }

      // ---- Caches (Cloud Function grava) ----
      match /_panel_cache/{docId} {
        allow read: if docId == 'public_site' || isMaster()
          || (docId == 'members_directory' && canReadAllMembers(id))
          || (docId != 'members_directory' && canAccessTenant(id));
        allow write: if false;
      }
      match /dashboard/{docId} {
        allow read: if isMaster() || canAccessTenant(id);
        allow write: if isMaster() || canWriteTenant(id);
      }
      match /_performance_cache/{docId} {
        allow read: if docId == 'public_feed' || isMaster() || canAccessTenant(id);
        allow write: if false;
      }
      match /finance_mp_notifications/{docId} {
        allow read: if canReadFinance(id); allow write: if false;
      }
      match /contribuicoes_dizimo_historico/{docId} {
        allow read: if isMaster() || canAccessTenant(id); allow write: if false;
      }

      // ---- Certificados / cartas ----
      match /certificados_historico/{certId} {
        allow read: if isMaster() || canAccessTenant(id);
        allow create, update, delete: if isAdminPanel() || canWriteTenant(id);
      }
      match /cartas_historico/{hid} {
        allow read: if isMaster() || canAccessTenant(id);
        allow create, update, delete: if isAdminPanel() || canWriteTenant(id);
      }
      match /certificados_emitidos/{certId} {
        allow get: if true;
        allow list: if isMaster() || canAccessTenant(id);
        allow create: if signedIn() && canWriteCertificados(id)
          && request.resource.data.certificadoId == certId
          && request.resource.data.tenantId == id;
        allow update, delete: if signedIn() && resource.data.tenantId == id
          && canWriteCertificados(id);
      }

      // ---- Frota (Jim Sabores) ----
      match /abastecimentos/{d} { allow read, write: if isMaster() || canAccessTenant(id); }
      match /combustiveis/{d} { allow read, write: if isMaster() || canAccessTenant(id); }
      match /veiculos/{d} { allow read, write: if isMaster() || canAccessTenant(id); }
      match /fleet_vehicles/{d} {
        allow read, create, update: if isMaster() || canAccessTenant(id); allow delete: if false;
      }
      match /fleet_fuelings/{d} {
        allow read, create, update: if isMaster() || canAccessTenant(id); allow delete: if false;
      }
      match /fleet_documents/{d} {
        allow read, create, update: if isMaster() || canAccessTenant(id); allow delete: if false;
      }

      // ---- Patrimônio ----
      match /patrimonio/{docId} {
        allow read: if canReadPatrimonio(id);
        allow create, update, delete: if canWritePatrimonio(id);
        match /manutencoes/{mid} {
          allow read: if canReadPatrimonio(id);
          allow create, update, delete: if canWritePatrimonio(id);
        }
        match /transferencias/{tid} {
          allow read: if canReadPatrimonio(id);
          allow create, update, delete: if canWritePatrimonio(id);
        }
      }
      match /patrimonio_inventario_historico/{hid} {
        allow read: if canReadPatrimonio(id);
        allow create, update, delete: if canWritePatrimonio(id);
      }

      // ---- Financeiro ----
      match /finance/{docId} {
        allow read: if canReadFinance(id)
          || (canAccessTenant(id) && ('memberDocId' in resource.data)
            && resource.data.memberDocId == uid());
        allow create, update, delete: if canWriteFinance(id);
      }
      match /finance_logs/{logId} {
        allow read: if canReadFinance(id);
        allow create: if canWriteFinance(id);
        allow update, delete: if false;
      }
      match /fornecedores/{docId} {
        allow read: if canReadFinance(id) || (canAccessTenant(id) && hasPerm(id, 'fornecedores'));
        allow create, update, delete: if canWriteFinance(id);
      }
      match /fornecedor_compromissos/{docId} {
        allow read: if canReadFinance(id) || (canAccessTenant(id) && hasPerm(id, 'fornecedores'));
        allow create, update, delete: if canWriteFinance(id);
      }
      match /categorias_receitas/{d} { allow read: if isMaster() || canAccessTenant(id); allow write: if isAdminPanel() || canWriteTenant(id); }
      match /categorias_despesas/{d} { allow read: if isMaster() || canAccessTenant(id); allow write: if isAdminPanel() || canWriteTenant(id); }
      match /contas/{d} { allow read: if isMaster() || canAccessTenant(id); allow write: if isAdminPanel() || canWriteTenant(id); }
      match /despesas_fixas/{d} { allow read: if isMaster() || canAccessTenant(id); allow write: if isAdminPanel() || canWriteTenant(id); }
      match /receitas_recorrentes/{d} { allow read: if isMaster() || canAccessTenant(id); allow write: if isAdminPanel() || canWriteTenant(id); }

      // ---- Usuários / índice do tenant ----
      match /usersIndex/{d} { allow read: if isMaster() || canAccessTenant(id); allow write: if isAdminPanel() || canWriteTenant(id); }
      match /users/{userId} { allow read: if isMaster() || canAccessTenant(id); allow write: if isAdminPanel() || canWriteTenant(id); }
      match /funcoesControle/{d} { allow read: if isMaster() || canAccessTenant(id); allow write: if isAdminPanel() || canWriteTenant(id); }

      // ---- Departamentos / cargos ----
      match /departamentos/{docId} {
        allow read: if isMaster() || canAccessTenant(id);
        allow write: if canWriteDepartamentos(id);
        match /membros_vinculados/{m} {
          allow read: if isMaster() || canAccessTenant(id);
          allow write: if canWriteDepartamentos(id);
        }
      }
      match /cargos/{docId} {
        allow read: if isMaster() || canAccessTenant(id);
        allow write: if canWriteCargos(id);
      }

      // ---- Eventos / avisos / mural (com engajamento social) ----
      match /event_templates/{docId} {
        allow read: if isMaster() || canAccessTenant(id)
          || !('active' in resource.data) || resource.data.active == true;
        allow create, update: if canWriteMural(id);
        allow delete: if isAdminPanel() || canWriteTenant(id) || (canAccessTenant(id) && isPastoral(id));
      }
      match /event_categories/{docId} {
        allow read: if isMaster() || canAccessTenant(id);
        allow write: if canWriteMural(id);
      }
      match /eventos/{docId} {
        allow read: if isMaster() || canAccessTenant(id) || publicSiteReadable();
        allow create: if canWriteMural(id);
        allow update: if socialCountersOnly(id) || canWriteMural(id);
        allow delete: if canWriteMural(id);
        match /comentarios/{cid} {
          allow read: if isMaster() || canAccessTenant(id) || engagePublic(id);
          allow create: if engage(id) && request.resource.data.authorUid == uid();
          allow delete: if (signedIn() && resource.data.authorUid == uid()) || isAdminPanel() || canWriteTenant(id);
          allow update: if false;
        }
        match /curtidas/{u} {
          allow read: if isMaster() || canAccessTenant(id) || engagePublic(id);
          allow create: if engage(id) && uid() == u && request.resource.data.uid == u;
          allow delete: if signedIn() && uid() == u;
          allow update: if false;
        }
        match /confirmacoes/{u} {
          allow read: if isMaster() || canAccessTenant(id) || engagePublic(id);
          allow create: if engage(id) && uid() == u && request.resource.data.uid == u;
          allow delete: if signedIn() && uid() == u;
          allow update: if false;
        }
      }
      match /avisos/{docId} {
        allow read: if isMaster() || canAccessTenant(id) || publicSiteReadable();
        allow create: if canWriteMural(id);
        allow update: if socialCountersOnly(id) || canWriteMural(id);
        allow delete: if canWriteMural(id);
        match /comentarios/{cid} {
          allow read: if isMaster() || canAccessTenant(id) || engagePublic(id);
          allow create: if engage(id) && request.resource.data.authorUid == uid();
          allow delete: if (signedIn() && resource.data.authorUid == uid()) || isAdminPanel() || canWriteTenant(id);
          allow update: if false;
        }
        match /curtidas/{u} {
          allow read: if isMaster() || canAccessTenant(id) || engagePublic(id);
          allow create: if engage(id) && uid() == u && request.resource.data.uid == u;
          allow delete: if signedIn() && uid() == u;
          allow update: if false;
        }
        match /confirmacoes/{u} {
          allow read: if isMaster() || canAccessTenant(id) || engagePublic(id);
          allow create: if engage(id) && uid() == u && request.resource.data.uid == u;
          allow delete: if signedIn() && uid() == u;
          allow update: if false;
        }
      }
      match /mural_avisos/{docId} {
        allow read: if isMaster() || canAccessTenant(id);
        allow create, update: if canWriteMural(id);
        allow delete: if canWriteMural(id);
      }
      match /events/{docId} {
        allow read: if isMaster() || canAccessTenant(id);
        allow create, update: if canWriteMural(id);
        allow delete: if canWriteMural(id);
      }
      match /noticias/{docId} {
        allow read: if isMaster() || canAccessTenant(id);
        allow create, update: if canWriteMural(id);
        allow delete: if canWriteMural(id);
      }
      match /agenda/{eventId} {
        allow read: if isMaster() || canAccessTenant(id);
        allow write: if canWriteMural(id);
      }

      // ---- Cultos / presença / visitantes / pastoral ----
      match /cultos/{cultoId} {
        allow read: if isMaster() || canAccessTenant(id);
        allow write: if isAdminPanel() || canWriteTenant(id);
        match /presencas/{p} {
          allow read: if isMaster() || canAccessTenant(id);
          allow write: if isAdminPanel() || canWriteTenant(id);
        }
      }
      match /visitantes/{docId} {
        allow read: if isMaster() || canAccessTenant(id);
        allow write: if isAdminPanel() || canWriteTenant(id)
          || (canAccessTenant(id) && isMemberOrVisitorRole(rlow()));
        match /followups/{f} {
          allow read: if isMaster() || canAccessTenant(id);
          allow write: if isAdminPanel() || canWriteTenant(id)
            || (canAccessTenant(id) && isMemberOrVisitorRole(rlow()));
        }
      }
      match /pastoral_mensagens/{msgId} {
        allow read: if isMaster() || canAccessTenant(id);
        allow create, update, delete: if false;
        match /leituras/{u} {
          allow read: if isMaster() || canAccessTenant(id);
          allow create, update: if signedIn() && canAccessTenant(id) && uid() == u
            && (request.resource.data.keys().hasOnly(['readAt'])
              || (request.resource.data.keys().hasOnly(['readAt', 'reply'])
                && request.resource.data.reply is string
                && request.resource.data.reply.size() <= 2000));
        }
      }
      match /devocional_envios/{d} {
        allow read: if isMaster() || canAccessTenant(id);
        allow create, update, delete: if false;
      }
      match /pedidosOracao/{docId} {
        allow read: if isMaster() || canAccessTenant(id);
        // self-branch PRIMEIRO (autorUid==uid barato) p/ nao estourar 1000 expressoes.
        allow create: if (signedIn() && request.resource.data.autorUid == uid() && canAccessTenant(id))
          || isAdminPanel() || canWriteTenant(id)
          || (canAccessTenant(id) && isPastoral(id));
        allow update, delete: if (signedIn() && resource.data.autorUid == uid())
          || isAdminPanel() || canWriteTenant(id)
          || (canAccessTenant(id) && isPastoral(id));
      }

      // ---- Uploads pendentes ----
      match /pending_uploads/{uploadId} {
        allow read, delete: if canAccessTenant(id) && signedIn() && resource.data.ownerUid == uid();
        allow create: if canAccessTenant(id) && signedIn()
          && request.resource.data.ownerUid == uid() && request.resource.data.tenantId == id;
        allow update: if canAccessTenant(id) && signedIn() && resource.data.ownerUid == uid();
      }

      // ---- Escalas ----
      match /escala_templates/{tplId} {
        allow read: if isMaster() || canAccessTenant(id);
        allow create, update, delete: if isAdminPanel() || canWriteTenant(id) || deptLeader(id);
      }
      match /escalas/{escId} {
        allow read: if isMaster() || canAccessTenant(id);
        allow create, delete: if isAdminPanel() || canWriteTenant(id) || deptLeader(id);
        // auto-confirmacao (self) PRIMEIRO p/ nao estourar 1000 expressoes com deptLeader/canWriteTenant.
        allow update: if scheduleSelfConfirm(id)
          || isAdminPanel() || canWriteTenant(id) || deptLeader(id);
      }
      match /escala_trocas/{trocaId} {
        allow read: if isMaster() || canAccessTenant(id);
        allow create: if signedIn() && canAccessTenant(id)
          && request.resource.data.status in ['pendente', 'pendente_alvo'];
        allow update, delete: if isAdminPanel() || canWriteTenant(id) || deptLeader(id);
      }

      // ---- Chat ----
      match /users_profile_chat/{u} {
        allow read: if signedIn() && uid() == u && canAccessTenant(id);
        allow create, update: if signedIn() && uid() == u && canAccessTenant(id);
        allow delete: if false;
      }
      match /chat_presence/{u} {
        allow read: if canAccessTenant(id);
        allow create, update: if signedIn() && uid() == u && canAccessTenant(id);
        allow delete: if false;
      }
      match /chat_peer_profiles/{authUid} { allow read: if canAccessTenant(id); allow write: if false; }
      match /chat_member_prefs/{u} {
        allow read: if signedIn() && uid() == u && canAccessTenant(id);
        allow create, update: if signedIn() && uid() == u && canAccessTenant(id);
        allow delete: if false;
      }
      match /chat_uploads/{uploadId} {
        allow read: if canAccessTenant(id) && signedIn() && resource.data.ownerUid == uid();
        allow create: if canAccessTenant(id) && signedIn() && request.resource.data.ownerUid == uid();
        allow update, delete: if canAccessTenant(id) && signedIn() && resource.data.ownerUid == uid();
      }
      match /chat_stickers/{stickerId} {
        allow read: if canAccessTenant(id);
        allow create: if canAccessTenant(id) && signedIn() && request.resource.data.createdByUid == uid();
        allow update: if false;
        allow delete: if canAccessTenant(id) && signedIn() && resource.data.createdByUid == uid();
      }
      match /chats/{threadId} {
        allow read: if canAccessTenant(id) && chatMember(threadId, resource.data);
        allow create: if canAccessTenant(id)
          && ((request.resource.data.type == 'dm'
                && request.resource.data.participantUids is list
                && uid() in request.resource.data.participantUids)
            || request.resource.data.type == 'department');
        allow update: if canAccessTenant(id) && chatMember(threadId, resource.data);
        allow delete: if canAccessTenant(id) && (chatMember(threadId, resource.data) || canWriteTenant(id) || isPastoral(id));
        match /typing/{t} {
          allow read: if canAccessTenant(id);
          allow create, update, delete: if canAccessTenant(id) && uid() == t;
        }
        match /messages/{msgId} {
          allow read: if canAccessTenant(id);
          allow create: if canAccessTenant(id)
            && request.resource.data.senderUid == uid()
            && request.resource.data.keys().hasAll(['senderUid', 'type', 'createdAt'])
            && !('reactionsByUid' in request.resource.data);
          // Updates: só campos permitidos, e não altera autoria/conteúdo base.
          allow update: if canAccessTenant(id)
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'deliveryStatus', 'uploadProgress', 'mediaUrl', 'storagePath', 'fileName',
              'thumbUrl', 'thumbStoragePath', 'thumbnailUrl', 'fileUrl', 'status',
              'uploadCompleted', 'storageVerified', 'updatedAt', 'pendingMedia',
              'erro', 'errorMessage', 'fileSize', 'size', 'stickerSource',
              'reactionsByUid', 'hiddenForUids'
            ]);
          allow delete: if canAccessTenant(id)
            && (resource.data.senderUid == uid() || canWriteTenant(id) || isPastoral(id));
        }
      }

      // ---- Pontes MP + índices (Cloud Function) ----
      match /mp_payment_bridge/{b} { allow read, write: if false; }
      match /mp_preference_bridge/{b} { allow read, write: if false; }
      match /certificados_protocol_index/{certId} {
        allow get: if true; allow list: if false;
        allow create: if signedIn() && canWriteCertificados(id);
        allow update, delete: if false;
      }
    }

    // ---- Helpers dependentes de escopo (usados acima) ----
    function canManagerConfig(t) { return isManager() || hasPerm(t, 'configuracoes_banco'); }
    function socialCountersOnly(t) {
      return signedIn() && canAccessTenant(t)
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['likes', 'likesCount', 'rsvp', 'rsvpCount', 'commentsCount', 'likedBy']);
    }
    function engage(t) { return signedIn() && (canAccessTenant(t) || publicSiteReadable()); }
    function engagePublic(t) { return isMaster() || canAccessTenant(t) || publicSiteReadable(); }
    // Líder de departamento (por uid nas listas do doc do departamento do request/resource).
    function deptLeaderOfDept(t, deptId) {
      let dp = /databases/$(database)/documents/igrejas/$(t)/departamentos/$(deptId);
      return deptId != '' && exists(dp) && (
        get(dp).data.get('leaderUid', '') == uid()
        || (get(dp).data.leaderUids is list && get(dp).data.leaderUids.hasAny([uid()]))
      );
    }
    function deptLeader(t) {
      let fromReq = request.resource != null && ('departmentId' in request.resource.data)
        && request.resource.data.departmentId is string ? request.resource.data.departmentId : '';
      let fromRes = resource != null && ('departmentId' in resource.data)
        && resource.data.departmentId is string ? resource.data.departmentId : '';
      return canAccessTenant(t) && (deptLeaderOfDept(t, fromReq) || deptLeaderOfDept(t, fromRes));
    }
    function scheduleSelfConfirm(t) {
      return signedIn() && canAccessTenant(t) && !canWriteTenant(t)
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['confirmations', 'unavailabilityReasons']);
    }
    // Membro do thread de chat (participante, DM pelo id, ou dept da igreja).
    function chatMember(threadId, d) {
      let inPart = d.participantUids is list && uid() in d.participantUids;
      let isDept = d.get('type', '') == 'department' || threadId.matches('^dept_.+');
      return inPart
        || threadId.matches('^dm_' + uid() + '_')
        || threadId.matches('_' + uid() + '$')
        || (isDept && signedIn());
    }

    // ========================================================================
    // Coleções de topo (usuário pessoal, master panel, legado)
    // ========================================================================

    function authEmailKey() { return emailLower(); }
    function isDelegateFor(userId) {
      let e = authEmailKey();
      let idx = /databases/$(database)/documents/delegate_email_index/$(e);
      return e != '' && exists(idx)
        && get(idx).data.get('principalUid', '') == userId
        && get(idx).data.get('active', false) == true;
    }
    function canAccessPersonal(userId) {
      return signedIn() && (uid() == userId || isDelegateFor(userId) || isMaster());
    }

    match /delegate_email_index/{emailKey} {
      allow read: if signedIn() && (authEmailKey() == emailKey
        || resource.data.get('principalUid', '') == uid() || isMaster());
      allow create, update: if signedIn()
        && (request.resource.data.get('principalUid', '') == uid() || isMaster())
        && request.resource.data.get('active', false) == true;
      allow delete: if signedIn() && (resource.data.get('principalUid', '') == uid() || isMaster());
    }

    match /users/{u} {
      allow read: if signedIn() && (uid() == u || isMaster() || peerSameTenant(u));
      allow update: if signedIn() && uid() == u;
      allow create: if signedIn() && uid() == u;
      allow delete: if isMaster() || isAdminPanel();

      match /fcmTokens/{token} {
        allow read, create, update, delete: if signedIn() && (uid() == u || isDelegateFor(u));
      }
      match /finance_month_buckets/{b} { allow read: if canAccessPersonal(u); allow write: if false; }
      match /finance_account_month_buckets/{b} { allow read: if canAccessPersonal(u); allow write: if false; }
      match /finance_stats/{d} { allow read: if canAccessPersonal(u); allow write: if false; }
      match /{allPaths=**} {
        allow read: if canAccessPersonal(u);
        allow write: if canAccessPersonal(u)
          && !(allPaths.matches('finance_month_buckets(/.*)?')
            || allPaths.matches('finance_account_month_buckets(/.*)?')
            || allPaths.matches('finance_stats(/.*)?'));
      }
    }

    // Leitura cruzada de users do mesmo tenant (diretório) — mantém login/listagem.
    function peerSameTenant(u) {
      let me = userDoc();
      let them = /databases/$(database)/documents/users/$(u);
      return signedIn() && exists(me) && exists(them) && (
        get(me).data.get('tenantId', 'a') == get(them).data.get('tenantId', 'b')
        || get(me).data.get('igrejaId', 'a') == get(them).data.get('igrejaId', 'b')
      );
    }

    match /subscriptions/{id} { allow read: if isAdminPanel(); allow write: if false; }
    match /suggestions/{id} {
      allow create: if signedIn();
      allow read: if signedIn() && (isMaster() || resource.data.userId == uid());
      allow update, delete: if isMaster();
    }
    match /suporte/{id} {
      allow read, update, delete: if isAdminPanel();
      allow create: if signedIn();
    }
    match /usuarios/{u} {
      allow read: if signedIn() && (uid() == u || isAdminPanel());
      allow update: if isAdminPanel();
      allow create: if signedIn() && uid() == u;
      allow delete: if false;
    }

    // Config/pública e painel master
    match /config/memberCard { allow read: if signedIn(); allow write: if isMaster(); }
    match /config/global_announcement { allow read: if signedIn(); allow write: if isMaster(); }
    match /config/featureFlags { allow read: if signedIn(); allow write: if isMaster(); }
    match /config/telegram_tdlib { allow read: if signedIn(); allow write: if isMaster(); }
    match /config/sistema { allow read: if signedIn(); allow write: if isAdminPanel(); }
    match /config/mercado_pago { allow read, write: if isAdminPanel(); }
    match /config/master_dashboard_summary { allow read: if isAdminPanel(); allow write: if false; }
    match /config/master_churches_index { allow read: if isAdminPanel(); allow write: if false; }
    match /config/analytics { allow read, write: if isMaster(); }
    match /config/_master_dashboard_lock { allow read, write: if false; }
    match /config/_master_churches_list_lock { allow read, write: if false; }
    match /analytics/{docId} {
      allow read, write: if isMaster();
      match /daily_hits/{h} { allow read, write: if isMaster(); }
    }
    match /global_announcement_audit/{id} { allow read, create, delete: if isMaster(); allow update: if false; }
    match /sales/{id} { allow read, create, update: if isAdminPanel(); allow delete: if false; }
    match /mp_payments/{id} { allow read, create, update: if isAdminPanel(); allow delete: if false; }
    match /church_mp_payments/{id} { allow read, write: if false; }
    match /licenses/{id} { allow read, create, update: if isAdminPanel(); allow delete: if false; }
    match /frota_customers/{id} { allow read, create, update: if isAdminPanel(); allow delete: if false; }
    match /drive_archives/{id} { allow read: if isAdminPanel(); allow write: if false; }
    match /planos/{id} { allow read, write: if isAdminPanel(); }
    match /pagamentos/{id} { allow read, write: if isAdminPanel(); }
    match /alertas/{id} { allow read, write: if isAdminPanel(); }
    match /admins/{u} { allow read: if isAdminPanel(); allow write: if false; }
    match /auditoria/{id} { allow read: if isAdminPanel(); allow write: if false; }
    match /security_events_rate/{u} { allow read, write: if false; }

    // Legado / público
    match /eventos/{eventoId} {
      allow read: if true; allow write: if false;
      match /comentarios/{c} { allow read: if true; allow write: if false; }
    }
    match /app_public/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminPanel() || (docId == 'institutional_gallery' && isManager());
    }
    match /certificados_emitidos/{certId} {
      allow get: if true; allow list: if false; allow create: if false;
      allow update, delete: if signedIn() && resource.data.tenantId is string
        && canWriteTenant(resource.data.tenantId);
    }
    match /certificados_protocol_index/{certId} {
      allow get: if true; allow list: if false;
      allow create: if signedIn() && request.resource.data.tenantId is string
        && canWriteTenant(request.resource.data.tenantId);
      allow update, delete: if false;
    }
    match /pendingUploads/{docId} {
      allow read, delete: if isMaster() || (signedIn() && resource.data.ownerUid == uid());
      allow create, update: if false;
    }

    // Deny-by-default para qualquer coisa não coberta acima.
    match /{document=**} { allow read, write: if false; }
  }
}
